APP_NAME=Lumora Roleplay API
APP_ENV=local
APP_DEBUG=true
DATABASE_URL=postgresql+psycopg://postgres:TU_PASSWORD@127.0.0.1:5432/Lumora
AUTO_CREATE_TABLES=false

# Redis: cache, cola basica y bloqueo por conversacion.
REDIS_URL=

# Qwen3 se ejecuta localmente mediante Ollama.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_EMBEDDING_DIMENSIONS=1024
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=10m
OLLAMA_CONTEXT_WINDOW=8192
OLLAMA_MAX_OUTPUT_TOKENS=1600
CHARACTER_RESEARCH_ENABLED=true
CHARACTER_RESEARCH_TIMEOUT_SECONDS=15
LOCAL_MEDIA_ROOT=storage/uploads
MAX_UPLOAD_BYTES=6291456

# OpenAI queda como proveedor alternativo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Integracion preparada para Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=bot-assets
ALLOW_DEV_AUTH=true
ALLOW_LOCAL_AUTH=true
LOCAL_JWT_SECRET=cambia-este-secreto-local
LOCAL_TOKEN_MINUTES=10080
DISCORD_SUPPORT_URL=

# Origenes CORS separados por comas.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1
