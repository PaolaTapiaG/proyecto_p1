# Copy this file to .env.production and replace every placeholder.
POSTGRES_PASSWORD=replace-with-a-long-unique-password
LOCAL_JWT_SECRET=replace-with-a-long-random-jwt-secret
ALLOW_LOCAL_AUTH=true
ALLOW_DEV_AUTH=false
TRUSTED_HOSTS=lumora.example.com
CORS_ORIGINS=https://lumora.example.com
OLLAMA_CHAT_MODEL=gemma4:12b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Optional: required only when Google login is configured in Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
